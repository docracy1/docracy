# Copy to .env.production (or set in CI) before building for a new domain.
# Must match apps/worker/wrangler.toml [vars] and apps/web/wrangler.toml [vars].

# Current production (docracy.io):
VITE_PUBLIC_APP_URL=https://docracy.io
VITE_PUBLIC_WORKER_URL=https://api.docracy.io
VITE_PUBLIC_CONNECTOR_URL=https://mcp.docracy.io

# docstoc.io cutover example:
# VITE_PUBLIC_APP_URL=https://docstoc.io
# VITE_PUBLIC_WORKER_URL=https://api.docstoc.io
# VITE_PUBLIC_CONNECTOR_URL=https://mcp.docstoc.io
