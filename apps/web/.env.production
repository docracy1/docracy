# Empty on purpose: /api/* is same-origin now via functions/api/[[path]].ts, which proxies to the
# worker server-side. This keeps the session cookie first-party (see that file for why).
VITE_API_URL=

# Public URLs — keep in sync with site.config.mjs and worker wrangler [vars].
VITE_PUBLIC_APP_URL=https://docracy.io
VITE_PUBLIC_WORKER_URL=https://api.docracy.io
VITE_PUBLIC_CONNECTOR_URL=https://mcp.docracy.io

# Cloudflare Turnstile's public sitekey (not secret) for the login form's bot check — Login.tsx
# renders no widget at all while this is empty, matching the worker's TURNSTILE_SECRET_KEY
# graceful-degrade. Create a widget with `wrangler turnstile widget create` and paste its sitekey
# here, then rebuild/redeploy.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAD-cJGdZ-ldgHyLC
