# Cloudflare Pages custom headers. worker-src/script-src allow 'self' + blob: for pdf.js, which
# loads its worker from a same-origin bundled URL but can fall back to a Blob-wrapped worker.
# style-src needs 'unsafe-inline' because the whole app uses React inline style={{}} props, which
# compile to inline style="" attributes — CSP gates those the same as <style> tags.
# script-src/frame-src/connect-src also allow challenges.cloudflare.com for the Turnstile widget
# on the login form (Login.tsx) — it loads an external script, renders in an iframe, and posts
# verification pings back to Cloudflare.
# script-src needs 'unsafe-inline': Cloudflare Bot Fight / email-obfuscation injects an inline
# bootstrap (+ a same-origin hidden iframe via frame-src 'self'). Without both, the challenge
# never completes and subsequent module fetches for /assets/*.js can get an HTML interstitial
# instead of JS — React never boots, so /login + /prepare look like the landing page.
# script-src/connect-src also allow www.clarity.ms + scripts.clarity.ms for Microsoft Clarity
# (session recording/heatmaps, admin-only /admin/analytics dashboard — public/clarity-loader.js
# is what actually decides whether to load it, this just permits the request once it does).
# frame-src also allows www.youtube-nocookie.com for embedded videos on blog posts (see the
# "video" ArticleBlock type in lib/articles.ts) — the nocookie domain skips ad-tracking cookies
# until the viewer actually plays the video.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://www.clarity.ms https://scripts.clarity.ms; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://challenges.cloudflare.com https://www.clarity.ms https://scripts.clarity.ms https://t.clarity.ms; frame-src 'self' https://challenges.cloudflare.com https://www.youtube-nocookie.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'

# Vite-built assets are content-hashed (index-<hash>.js), but deliberately NOT marked `immutable`
# with a year-long max-age: Cloudflare Pages' deploy propagation isn't atomic across edge nodes, and
# a request landing on a not-yet-updated node can transiently get the SPA-fallback HTML (still a 200)
# for a brand new asset path. `immutable` would make a browser that caught that bad response cache it
# permanently with no way to self-correct. A moderate max-age bounds the worst case to a few hours
# instead of a year, while still avoiding a refetch on every load.
/assets/*
  Cache-Control: public, max-age=14400, must-revalidate

# Favicons: short cache so a bad prior response (e.g. SPA HTML for /favicon.ico) can recover,
# and so ?v= cache-bust query bumps take effect quickly across browsers.
/favicon.ico
  Cache-Control: public, max-age=86400, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=86400, must-revalidate

/favicon.png
  Cache-Control: public, max-age=86400, must-revalidate

/favicon-32.png
  Cache-Control: public, max-age=86400, must-revalidate

/apple-touch-icon.png
  Cache-Control: public, max-age=86400, must-revalidate

# RFC 8288 Link headers pointing agents/crawlers at real, existing resources — deliberately not an
# api-catalog link, since there's no /.well-known/api-catalog file behind it yet; /docs now has a
# genuine REST API reference section (see Docs.tsx), so service-doc is honest.
/
  Link: </docs>; rel="service-doc", </privacy>; rel="privacy-policy", </terms>; rel="terms-of-service"

# Embedded signing must be iframe-able. Omit X-Frame-Options here so only CSP frame-ancestors *
# applies (Cloudflare Pages may not honor ALLOWALL, and DENY from /* would block embeds).
/embed/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://challenges.cloudflare.com; frame-src 'self' https://challenges.cloudflare.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors *
